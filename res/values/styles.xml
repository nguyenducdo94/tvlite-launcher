<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#0B0D12</color>
    <color name="card">#1C2030</color>
    <color name="sheet">#E6090B10</color>
    <color name="text">#FFFFFF</color>
    <color name="text_dim">#99A3B4</color>

    <style name="Theme.TvLite" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@drawable/bg</item>
        <item name="android:colorAccent">#4D8DFF</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>

    <!-- Text that sits straight on the wallpaper -->
    <style name="Shadowed">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">8</item>
    </style>

    <style name="Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginLeft">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:background">@drawable/pill</item>
        <item name="android:textColor">@color/pill_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
