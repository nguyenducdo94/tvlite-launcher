<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Scrims: just enough shade under the clock and the dock to read them on any picture -->
    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="top"
        android:background="@drawable/scrim_top" />

    <View
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom" />

    <!-- Home layer -->
    <FrameLayout
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="48dp"
        android:paddingRight="48dp"
        android:paddingTop="30dp"
        android:paddingBottom="30dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/greeting"
                style="@style/Shadowed"
                android:textColor="#D9FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/clock"
                style="@style/Shadowed"
                android:fontFamily="sans-serif-thin"
                android:includeFontPadding="false"
                android:textColor="@color/text"
                android:textSize="76sp" />

            <TextView
                android:id="@+id/date"
                style="@style/Shadowed"
                android:textColor="#D9FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|right"
            android:orientation="horizontal">

            <TextView android:id="@+id/pill_inputs" style="@style/Pill" android:text="@string/inputs" />
            <TextView android:id="@+id/pill_wifi" style="@style/Pill" android:text="@string/wifi" />
            <TextView android:id="@+id/pill_settings" style="@style/Pill" android:text="@string/settings" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Name of the focused dock app, large, as on Apple TV -->
            <TextView
                android:id="@+id/focused_name"
                style="@style/Shadowed"
                android:layout_marginBottom="14dp"
                android:fontFamily="sans-serif-light"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textSize="30sp" />

            <LinearLayout
                android:id="@+id/dock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/dock_band"
                android:orientation="horizontal"
                android:padding="16dp"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </LinearLayout>
    </FrameLayout>

    <!-- All apps: a dark sheet over the wallpaper, opened from the last dock tile -->
    <ScrollView
        android:id="@+id/drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/sheet"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="48dp"
            android:paddingRight="48dp"
            android:paddingTop="32dp"
            android:paddingBottom="40dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:fontFamily="sans-serif-light"
                android:text="@string/all_apps"
                android:textColor="@color/text"
                android:textSize="28sp" />

            <LinearLayout
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/hint"
                android:textColor="#66FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
